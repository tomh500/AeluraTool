<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
 <ItemDefinitionGroup Condition="'$(MSBuildProjectName)'=='AeluraTool'"><ClCompile><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile></ItemDefinitionGroup>
 <Target Name="BuildCaptureEngine" BeforeTargets="PrepareForBuild" Condition="'$(MSBuildProjectName)'=='AeluraTool'">
  <Error Condition="'$(Platform)'!='x64'" Text="遥汐工具箱首版仅支持 x64，请选择 x64 配置。"/>
  <MSBuild Projects="$(MSBuildThisFileDirectory)Tools\ScreenShotPlus\AeluraCapture.vcxproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64"/>
 </Target>
 <ItemGroup Condition="'$(MSBuildProjectName)'=='AeluraTool'">
  <Content Include="$(MSBuildThisFileDirectory)artifacts\x64\$(Configuration)\ScreenShotPlus.Host.exe"><Link>Tools\ScreenShotPlus.Host.exe</Link><DeploymentContent>true</DeploymentContent><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  <Content Include="$(MSBuildThisFileDirectory)Tools\ScreenShotPlus\LICENSE"><Link>Tools\Licenses\ScreenShotPlus.LICENSE.txt</Link><DeploymentContent>true</DeploymentContent><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  <Content Include="$(MSBuildThisFileDirectory)Tools\ScreenShotPlus\THIRD_PARTY_NOTICES.md"><Link>Tools\Licenses\THIRD_PARTY_NOTICES.md</Link><DeploymentContent>true</DeploymentContent><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
 </ItemGroup>
 <Target Name="CopyCaptureEngine" AfterTargets="Build" Condition="'$(MSBuildProjectName)'=='AeluraTool'"><MakeDir Directories="$(OutDir)Tools"/><Copy SourceFiles="$(MSBuildThisFileDirectory)artifacts\x64\$(Configuration)\ScreenShotPlus.Host.exe" DestinationFolder="$(OutDir)Tools"/></Target>
</Project>