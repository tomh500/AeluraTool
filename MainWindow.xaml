<Window x:Class="AeluraTool.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AeluraTool">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <Style x:Key="NavigationSelected" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></Style>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
   <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/></Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <AutoSuggestBox x:Name="Search" Grid.Column="1" Margin="32,18,32,0" MaxWidth="640" HorizontalAlignment="Stretch" PlaceholderText="" QueryIcon="Find" AutomationProperties.Name=""/>
  <Border x:Name="SidebarShell" Grid.RowSpan="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="18,28">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24" Spacing="16"><Button x:Name="HistoryBackButton" Width="36" Height="32" IsEnabled="False" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button><StackPanel Margin="10,0,0,0" Spacing="5"><TextBlock x:Name="Localized1" Text="" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="AELURA TOOL" FontSize="11" CharacterSpacing="180" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></StackPanel>
    <StackPanel Grid.Row="1" Spacing="6">
     <TextBlock x:Name="Localized2" Text="" FontSize="12" Margin="12,22,0,6" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Button x:Name="ImageNav" Content="" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
     <Button x:Name="FilesNav" Content="" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
     <Button x:Name="GamesNav" Content="" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="6"><Button x:Name="KeysNav" Content="" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/><Button x:Name="PreferencesNav" Content="" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/></StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="ContentShell" Grid.Row="1" Grid.Column="1" Padding="32,24" RowSpacing="18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid>
    <StackPanel Spacing="5"><TextBlock x:Name="PageTitle" Text="" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   </Grid>
   <InfoBar x:Name="Status" Grid.Row="1" IsOpen="False" IsClosable="True"/>
   <StackPanel Grid.Row="2" Spacing="10">
    <TextBlock x:Name="ResultCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
    <StackPanel x:Name="HashTaskStrip" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
     <TextBlock x:Name="HashTaskText" VerticalAlignment="Center"/>
     <Button x:Name="HashTaskOpen" Content=""/>
     <Button x:Name="HashTaskCancel" Content=""/>
    </StackPanel>
   </StackPanel>
   <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18">
    <StackPanel x:Name="HomePage" Spacing="16"><StackPanel x:Name="ToolCards" Spacing="12"/><TextBlock x:Name="NoResults" Text="" Visibility="Collapsed"/></StackPanel>
    <StackPanel x:Name="RecordingPage" Spacing="16" Visibility="Collapsed"><Button x:Name="RecordingBackButton" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14"/><TextBlock x:Name="RecordingBackLabel"/></StackPanel></Button><Border Style="{StaticResource Card}"><ContentControl x:Name="RecordingHost" HorizontalContentAlignment="Stretch"/></Border></StackPanel>
    <StackPanel x:Name="KeysPage" Spacing="18" Visibility="Collapsed"><AutoSuggestBox x:Name="KeySearch" PlaceholderText="" QueryIcon="Find" AutomationProperties.Name=""/><StackPanel x:Name="KeyRows" Spacing="8"/><TextBlock x:Name="NoKeys" Text="" Visibility="Collapsed"/><TextBlock x:Name="Localized3" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    <StackPanel x:Name="PreferencesPage" Spacing="18" Visibility="Collapsed">
     <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock x:Name="BehaviorTitle" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="CloseActionChoice" Width="300"><ComboBoxItem x:Name="CloseAskOption"/><ComboBoxItem x:Name="CloseExitOption"/><ComboBoxItem x:Name="CloseTrayOption"/></ComboBox><ToggleSwitch x:Name="AutoStartSwitch"/><TextBlock x:Name="AutoStartState" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock x:Name="Localized4" Text="" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="ThemeChoice" Header="" Width="240"><ComboBoxItem x:Name="Localized5" Content=""/><ComboBoxItem x:Name="Localized6" Content=""/><ComboBoxItem x:Name="Localized7" Content=""/></ComboBox><ComboBox x:Name="LanguageChoice" Header="" Width="280"><ComboBoxItem x:Name="Localized8" Content=""/><ComboBoxItem x:Name="Localized9" Content=""/><ComboBoxItem x:Name="Localized10" Content=""/></ComboBox><ToggleSwitch x:Name="StartupMotionSwitch" Header="" IsOn="True"/><TextBlock x:Name="Localized11" Text="" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button x:Name="PreviewMotionButton" Content=""/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock x:Name="Localized12" Text="" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="AeluraTool" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button x:Name="LicensesButton" Content=""/></StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="HashPage" Spacing="16" Visibility="Collapsed"><Button x:Name="HashBackButton" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14"/><TextBlock x:Name="HashBackLabel"/></StackPanel></Button><Border Style="{StaticResource Card}"><StackPanel Spacing="14">
     <TextBlock x:Name="HashHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <ComboBox x:Name="HashMode" SelectedIndex="0" HorizontalAlignment="Stretch">
      <ComboBoxItem x:Name="HashCalculateMode"/><ComboBoxItem x:Name="HashExpectedMode"/><ComboBoxItem x:Name="HashCompareMode"/>
     </ComboBox>
     <TextBox x:Name="HashFirstPath"/>
     <Button x:Name="HashFirstPick"/>
     <StackPanel x:Name="HashExpectedPanel" Spacing="8" Visibility="Collapsed"><TextBox x:Name="HashExpected" TextWrapping="Wrap"/></StackPanel>
     <StackPanel x:Name="HashSecondPanel" Spacing="8" Visibility="Collapsed"><TextBox x:Name="HashSecondPath"/><Button x:Name="HashSecondPick"/></StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="HashStart" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="HashCancel" Visibility="Collapsed"/></StackPanel>
     <ProgressBar x:Name="HashProgress" Maximum="100" Visibility="Collapsed"/>
     <TextBlock x:Name="HashState" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel x:Name="HashResults" Spacing="10" Visibility="Collapsed">
      <TextBox x:Name="HashFirstResult" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/>
      <Button x:Name="HashFirstCopy"/>
      <TextBox x:Name="HashSecondResult" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Visibility="Collapsed"/>
      <Button x:Name="HashSecondCopy" Visibility="Collapsed"/>
     </StackPanel>
    </StackPanel></Border></StackPanel>
    <StackPanel x:Name="MovePage" Spacing="18" Visibility="Collapsed"><Button x:Name="MoveBackButton" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14"/><TextBlock x:Name="MoveBackLabel"/></StackPanel></Button><Border Style="{StaticResource Card}"><StackPanel Spacing="18">
     <TextBlock x:Name="Localized13" Text="" TextWrapping="Wrap"/>
     <TextBox x:Name="SourcePath" Header="" PlaceholderText=""/>
     <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="SourceFileButton" Content=""/><Button x:Name="SourceFolderButton" Content=""/></StackPanel>
     <TextBox x:Name="DestinationPath" Header="" PlaceholderText=""/><Button x:Name="DestinationButton" Content="" HorizontalAlignment="Left"/>
     <TextBlock x:Name="MoveSummary" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ProgressBar x:Name="MoveProgress" Visibility="Collapsed" Maximum="100"/>
     <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="CheckMoveButton" Content=""/><Button x:Name="MoveButton" Content="" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="CancelMoveButton" Content="" Visibility="Collapsed"/></StackPanel>
    </StackPanel></Border></StackPanel>
   </StackPanel></ScrollViewer>
  </Grid>
  <Grid x:Name="StartupLayer" Grid.Row="1" Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
    <Grid x:Name="TideMark" Width="300" Height="64" RenderTransformOrigin="0.5,0.5">
     <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
     <Ellipse Width="10" Height="10" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.65"/>
     <Path Data="M0,36 C50,4 100,4 150,36 S250,68 300,36" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.8"/>
     <Path Data="M0,44 C50,14 100,14 150,44 S250,74 300,44" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.25"/>
    </Grid>
    <TextBlock x:Name="StartupName" HorizontalAlignment="Center" FontSize="34" FontWeight="SemiBold"/>
    <TextBlock Text="AELURA TOOL" HorizontalAlignment="Center" FontSize="11" CharacterSpacing="240" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
