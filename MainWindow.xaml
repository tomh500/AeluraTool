<Window x:Class="AeluraTool.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="遥汐工具箱 · AeluraTool">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#151E25" Padding="22,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="遥汐" FontSize="32" FontWeight="SemiBold" Foreground="#81D8CA"/>
                    <TextBlock Text="A E L U R A  T O O L" FontSize="11" Foreground="#9AAFB9"/>
                    <TextBlock Text="把顺手的工具，放在一起。" FontSize="12" Margin="0,12,0,26" Foreground="#9AAFB9"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="10">
                    <Button x:Name="HomeNav" Content="&#xE80F;   工具百宝箱" FontFamily="Segoe UI, Segoe Fluent Icons" HorizontalAlignment="Stretch"/>
                    <Button x:Name="KeysNav" Content="&#xE765;   全局快捷键" FontFamily="Segoe UI, Segoe Fluent Icons" HorizontalAlignment="Stretch"/>
                    <Button x:Name="AboutNav" Content="&#xE946;   关于遥汐" FontFamily="Segoe UI, Segoe Fluent Icons" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="第一件工具，已经就位。" Foreground="#81D8CA" FontSize="12"/>
                    <TextBlock Text="v0.1 · C++ / WinUI 3" Foreground="#9AAFB9" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="38,32,38,30" Spacing="24">
                <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Severity="Informational" Title="欢迎来到遥汐" Message="截图工具已接入；快捷键在工具箱运行时生效。"/>
                <StackPanel x:Name="HomePage" Spacing="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="工具百宝箱" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="从一次截图开始，让日常操作更轻一点。" Foreground="#A6B6BF"/>
                    </StackPanel>
                    <AutoSuggestBox x:Name="Search" PlaceholderText="搜索工具，例如：截图、ScreenShotPlus" QueryIcon="Find"/>
                    <Border x:Name="CaptureCard" Background="#1D2C34" BorderBrush="#34545A" BorderThickness="1" CornerRadius="16" Padding="28">
                        <StackPanel Spacing="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE722;" FontSize="30" Foreground="#81D8CA" HorizontalAlignment="Left"/>
                                    <TextBlock Text="截图与分享" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock Text="ScreenShotPlus" Foreground="#A6B6BF"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#254B46" CornerRadius="6" Padding="12,6" VerticalAlignment="Top">
                                    <TextBlock Text="已集成" Foreground="#9EE8D7" FontSize="12"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="区域 / 窗口截图、标注编辑、PNG 保存，以及浮窗拖放分享。" TextWrapping="Wrap" Foreground="#C0CDD4"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="CaptureButton" Content="开始截图" Style="{StaticResource AccentButtonStyle}"/>
                                <Button x:Name="SettingsButton" Content="截图设置"/>
                                <Button x:Name="PreviewButton" Content="最近截图"/>
                            </StackPanel>
                            <TextBlock x:Name="ShortcutLabel" Text="全局快捷键：Ctrl + Alt + A" Foreground="#81D8CA" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="NoResults" Text="没有找到匹配的工具。" Visibility="Collapsed" Foreground="#A6B6BF"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#1B252D" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="01  源码集成" FontWeight="SemiBold"/>
                                <TextBlock Text="为现有能力接上统一入口" FontSize="12" Foreground="#A6B6BF" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1B252D" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="02  外部程序" FontWeight="SemiBold"/>
                                <TextBlock Text="后续接入已有 EXE 工具" FontSize="12" Foreground="#A6B6BF" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#1B252D" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="03  原生工具" FontWeight="SemiBold"/>
                                <TextBlock Text="为真正的需求从零构建" FontSize="12" Foreground="#A6B6BF" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="KeysPage" Spacing="22" Visibility="Collapsed">
                    <TextBlock Text="全局快捷键" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="在这里统一管理工具的唤起方式。保存时会检查占用冲突。" Foreground="#A6B6BF" TextWrapping="Wrap"/>
                    <Border Background="#1D2C34" CornerRadius="14" Padding="24">
                        <StackPanel Spacing="18">
                            <TextBlock Text="截图与分享 · 开始截图" FontSize="20"/>
                            <ToggleSwitch x:Name="EnableKeys" Header="启用全局快捷键" IsOn="True"/>
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <CheckBox x:Name="CtrlKey" Content="Ctrl" IsChecked="True"/>
                                <CheckBox x:Name="AltKey" Content="Alt" IsChecked="True"/>
                                <CheckBox x:Name="ShiftKey" Content="Shift"/>
                            </StackPanel>
                            <ComboBox x:Name="KeyChoice" Header="按键" Width="220"/>
                            <CheckBox x:Name="PrintKey" Content="同时接管 PrintScreen"/>
                            <Button x:Name="SaveKeys" Content="保存快捷键" Style="{StaticResource AccentButtonStyle}"/>
                            <TextBlock Text="集成版截图工具不再提供快捷键编辑。&#x0a;关闭工具箱后释放全部快捷键。PrintScreen 可能与系统截图冲突。" Foreground="#A6B6BF" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="AboutPage" Spacing="20" Visibility="Collapsed">
                    <TextBlock Text="关于遥汐" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="遥汐工具箱 / AeluraTool" FontSize="22"/>
                    <TextBlock Text="一个持续生长的系统工具百宝箱。" Foreground="#A6B6BF"/>
                    <TextBlock Text="界面使用 C++/WinRT 与 WinUI 3。首个工具基于 ScreenShotPlus 源码，作为受工具箱管理的截图进程运行，保留原有截图与标注界面。" TextWrapping="Wrap"/>
                    <TextBlock Text="ScreenShotPlus · MIT License&#x0a;第三方声明随源码保留于 Tools/ScreenShotPlus。" TextWrapping="Wrap" Foreground="#A6B6BF"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>